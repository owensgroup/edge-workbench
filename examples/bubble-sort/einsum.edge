# Bubble sort -- ASCII surface form of the tutorial's edge_expression,
# transcribed line for line. A nested cascade: the outer cascade iterates the
# pass rank i, the inner cascade the step rank j.

- Tensors
A^{N = |A|}                  -> integer, empty = inf
Z^{I = N-1, J = N-1, M = N}  -> integer, empty = inf

- Initializations        # pass 0, step 0: first compare-exchange of A_0, A_1
Z_{0, 0, n} = cases:
    min(A_0, A_1)   if n = 0
    max(A_0, A_1)   if n = 1
    empty           otherwise

- Extended Einsums
- Begin outer cascade (passes): i = 0
- Begin inner cascade (steps)
# E01: pass 0, step j (j >= 1): bubble the max rightward through A
Z_{0, j : j >= 1, n} = cases:
    Z_{0, j-1, n}                  if n < j
    min(Z_{0, j-1, j}, A_{j+1})    if n = j
    max(Z_{0, j-1, j}, A_{j+1})    if n = j+1
    empty                          otherwise
# E02: pass i (i >= 1), step 0: first compare-exchange reads the previous pass's final row
Z_{i : i >= 1, 0, n} = cases:
    min(Z_{i-1, J-1, 0}, Z_{i-1, J-1, 1})   if n = 0
    max(Z_{i-1, J-1, 0}, Z_{i-1, J-1, 1})   if n = 1
    Z_{i-1, J-1, n}                         if n >= 2
# E03: pass i (i >= 1), step j (j >= 1): bubble rightward through the previous pass's final row
Z_{i : i >= 1, j : j >= 1, n} = cases:
    Z_{i, j-1, n}                           if n < j
    min(Z_{i, j-1, j}, Z_{i-1, J-1, j+1})   if n = j
    max(Z_{i, j-1, j}, Z_{i-1, J-1, j+1})   if n = j+1
    Z_{i-1, J-1, n}                         if n > j+1
<><> : j == J                      # end inner cascade (pass complete)
<> : Z_{i+1, J-1} == Z_{i, J-1}    # end outer cascade (no change this pass)

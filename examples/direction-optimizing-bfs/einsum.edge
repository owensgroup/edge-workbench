# Direction-Optimizing BFS, top-down -- ASCII surface form of the tutorial's
# edge_expression, transcribed line for line.

- Tensors
G^{S = |V|, D = |V|}        -> Boolean, empty = False
F^{I, S = |V|}              -> Boolean, empty = False
Tree^{I, S = |V|, D = |V|}  -> Boolean, empty = False

# NOT declared in the tutorial. Used by the cascade below, so they are declared
# here; the empty values are choices, not the tutorial's.
Nei^{I, D = |V|}                -> Boolean, empty = False
Visited^{I, D = |V|}            -> Boolean, empty = False
NV^{I, D = |V|}                 -> Boolean, empty = False
NeiNV^{I, D = |V|}              -> Boolean, empty = False
CandTree^{I, S = |V|, D = |V|}  -> Boolean, empty = False
Temp^{I, S = |V|, D = |V|}      -> Boolean, empty = False

- Initializations        # n = source vertex
F_{i, s} = False
Tree_{i, s, d} = False
F_{0, n} = True
Tree_{0, n, n} = True

- Extended Einsums
# E01: gather neighbors of the frontier
Nei_{i, d} = G_{s, d} . F_{i, s} :: /\_s AND(∩) \/_s OR(∪)
# E02: find visited vertices from the tree
Visited_{i, c} = Tree_{i, p, c} :: \/_p OR(∪)
# E03: the vertices that are not visited
NV_{i, c} = not Visited_{i, c}
# E04: keep neighbors that are not yet visited
NeiNV_{i, d} = Nei_{i, d} . NV_{i, d} :: /\_d AND(∩)
# E05: record candidate parent-child edges
CandTree_{i, s, d} = (G_{s, d} . F_{i, s})_{i, s, d} . NeiNV_{i, d} :: /\ AND(∩) /\ AND(∩)
# E06: select exactly one parent per child
Temp_{i, s*, d} = CandTree_{i, s, d} :: <<<_{s*} 1(pick-parent)
# E07: update the BFS tree
Tree_{i+1, s, d} = Tree_{i, s, d} . Temp_{i, s, d} :: /\_d OR(∪)
# E08: set the next frontier
F_{i+1, d} = NeiNV_{i, d}
<> : ||F_{i+1}|| == 0

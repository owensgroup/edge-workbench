{
  "name": "edge-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Builds a verified, explorable page by executing an EDGE specification",
  "scripts": {
    "build": "python3 edge_workbench/render/build_page.py",
    "check": "node algorithms/max-flow/tests/check_page.js",
    "check:verbose": "node algorithms/max-flow/tests/check_page.js -v",
    "gates": "python3 -m pytest tests -q",
    "test": "npm run build && npm run views && npm run check && npm run gates",
    "views": "node tests/check_domain_views.js",
    "views:verbose": "node tests/check_domain_views.js -v",
    "prepare": "python3 -m edge_workbench.prepare"
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  }
}
